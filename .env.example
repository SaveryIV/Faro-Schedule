# Postgres connection (Neon). Use the POOLED host (…-pooler…). This is the only
# database variable the app needs, locally and on Vercel.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"

# Office timezone used to interpret booking form times (IANA name).
OFFICE_TZ="America/Argentina/Buenos_Aires"

# The SUPER_ADMIN account, created/refreshed by `npm run db:seed`. Re-running the
# seed re-asserts this account as SUPER_ADMIN and rotates its password to this
# value, so it can never be locked out.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="Office Admin"
