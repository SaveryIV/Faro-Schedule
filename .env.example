# Postgres connection (Neon). Use the POOLED host (…-pooler…) for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# The DIRECT (non-pooled) host, same credentials without "-pooler". Used by
# Prisma Migrate. On Vercel, set both.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"

# Office timezone used to interpret booking form times (IANA name).
OFFICE_TZ="America/Argentina/Buenos_Aires"

# First admin, created by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_NAME="Office Admin"
